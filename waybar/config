{
    "position": "bottom",
    "height": 30,
    "spacing": 5, 

    "modules-left": [
        "group/workspaces",
    ],
    "modules-center": [
        // "group/windows",
        "group/datetime"
    ],
    "modules-right": [
        "group/cpuram",
        "group/system",
        "group/power",
        //"group/wifiblue",
        "group/tray-box"
    ],

    "custom/openbracket": {
        "format": "[",
        "tooltip": false
    },
    "custom/closebracket": {
        "format": "]",
        "tooltip": false
    },
    "custom/split": {
      "format": "|",
      "tooltip": false
    },

    "group/utilities": {
        "orientation": "horizontal",
        "modules":[
            "custom/openbracket",
            "custom/void",
            "custom/closebracket"
        ]
    },
    "group/workspaces":{
        "orientation": "horizontal",
        "modules":[
            "custom/openbracket",
            "sway/workspaces",
            "custom/closebracket"
        ]
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}"
    },

    "group/music": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "mpris",
            "custom/closebracket"
        ]
    },
    "mpris": {
        "format": "PLAY: {status_icon} | {dynamic}",
        "interval": 1,
        "dynamic-len": 40,
        "status-icons": {
            "playing": "▶",
            "paused": "⏸",
            "stopped": "⏹"
        },
        "dynamic-order": ["artist"]
    },

    // Window name section (Left here for reference, but disabled in modules-center)
    "group/windows": {
        "orientation":"horizontal",
        "modules":[
            "custom/openbracket",
            "sway/window",
            "custom/closebracket"
        ]
    },
    "sway/window": {
        "format": "{title}",
        "max-length": 50,
        "rewrite": {
            "(.*) - foot": "TRM: $1"
        }
    },

    "group/datetime": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "clock#date",
            "custom/split",
            "clock#time",
            "custom/closebracket"
        ]
    },
    "clock#date": {
        "format": "{:%d-%m-%Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "clock#time": {
        "format": "{:%H:%M}",
        "tooltip": false
    },

    "group/cpuram": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "cpu",
            "custom/split",
            "memory",
          //  "custom/split",
          //  "temperature",
            "custom/closebracket"
        ]
    },
    "cpu": {
        "format": "CPU:{usage}%",
        "tooltip": false,
        "interval": 30,
        "on-click": "footclient -e btop"
    },
    "memory":{
        "format": "RAM:{}%",
        "tooltip": false,
        "interval": 30,
        "on-click": "footclient -e btop"
    },
    "temperature": {
        "format": "TEMP:{temperatureC}°C",
        "tooltip": false,
        "interval": 30,
        "on-click": "footclient -e btop"
    },

    "group/system": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "pulseaudio",
            "custom/split",
            "backlight",
            "custom/closebracket"
        ]
    },
    "group/power": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "battery",
            "custom/split",
            "power-profiles-daemon",
            "custom/closebracket"
        ]
    },
    "pulseaudio": {
        "format": "VOL:{volume}%",
        "format-muted": "VOL:MUT",
        "tooltip": false,
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "BRI:{percent}%",
        "tooltip": false,
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%- -n 1%"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "BAT:{capacity}%"
    },
    "power-profiles-daemon": {
          "format": "PPD:{icon}",
          "tooltip": false,
          "format-icons": {
              "default": "BAL",
              "performance": "PERF",
              "balanced": "BAL",
              "power-saver": "PWR"
          }
      },

    "group/wifiblue": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "network",
            "custom/split",
            "bluetooth",
            "custom/closebracket"
        ]
    },
    "network": {
        "format-wifi": "NET:{ipaddr}",
        "format-ethernet": "NET:{ipaddr}",
        "format-disconnected": "NET:DOWN",
        "tooltip": false,
        "on-click": "footclient -e impala-nm",
    },
    "bluetooth": {
        "format": "BT:OFF",
        "format-on": "BT:ON",
        "format-connected": "BT:CONN",
        "format-disabled": "BT:OFF",
        "tooltip": false,
        "on-click": "footclient -e bluetui",
    },

    "group/tray-box": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "tray",
            "custom/closebracket"
        ]
    },
    "tray": {
        "icon-size": 14,
        "spacing": 10
    }
}
