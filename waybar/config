{
    "position": "bottom",
    "height": 30,
    "spacing": 5, 

    "modules-left": [
        "group/workspaces"
    ],
    "modules-center": [
        "group/windows"
    ],
    "modules-right": [
        "group/cpuram",
        "group/system",
        "group/tray-box"
    ],

    "custom/openbracket": {
        "format": "[",
        "tooltip": false
    },
    "custom/closebracket": {
        "format": "]",
        "tooltip": false
    },
    "custom/split": {
      "format": "|",
      "tooltip": false
    },

    "group/utilities": {
        "orientation": "horizontal",
        "modules":[
            "custom/openbracket",
            "custom/void",
            "custom/closebracket"
        ]
    },
    "custom/void": {
        "format": "SYS",
        "tooltip": false,
        "on-click": "bemenu-run -b -i -p '' -W 0.27 --fn 'BlexMono Nerd Font 11' --tb '#2c2d30' --tf '#b1b4b9' --fb '#2c2d30' --ff '#b1b4b9' --nb '#2c2d30' --nf '#b1b4b9' --hb '#68aee8' --hf '#2c2d30'"
    },

    "group/workspaces":{
        "orientation": "horizontal",
        "modules":[
            "custom/openbracket",
            "sway/workspaces",
            "custom/closebracket"
        ]
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}"
    },

    "group/music": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "mpris",
            "custom/closebracket"
        ]
    },
    "mpris": {
        "format": "PLAY: {status_icon} | {dynamic}",
        "interval": 1,
        "dynamic-len": 40,
        "status-icons": {
            "playing": "▶",
            "paused": "⏸",
            "stopped": "⏹"
        },
        "dynamic-order": ["artist"]
    },

    "group/windows": {
        "orientation":"horizontal",
        "modules":[
            "custom/openbracket",
            "sway/window",
            "custom/closebracket"
        ]
    },
    "sway/window": {
        "format": "{title}",
        "max-length": 50,
        "rewrite": {
            "(.*) - foot": "TRM: $1"
        }
    },

    "group/cpuram": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "cpu",
            "custom/split",
            "memory",
            "custom/closebracket"
        ]
    },
    "cpu": {
        "format": "CPU:{usage}%",
        "tooltip": false,
        "interval": 2,
        "on-click": "footclient -e btop"
    },
    "memory":{
        "format": "RAM:{}%",
        "tooltip": false,
        "interval": 2,
        "on-click": "footclient -e btop"
    },

    "group/system": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "clock",
            "custom/split",
            "backlight",
            "custom/split",
            "battery",
            "custom/closebracket"
        ]
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "BRI:{percent}%",
        "tooltip": false,
        "on-scroll-up": "swayosd-client --brightness +5",
        "on-scroll-down": "swayosd-client --brightness -5"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "BAT:{capacity}%"
    },

    "group/tray-box": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "tray",
            "custom/closebracket"
        ]
    },
    "tray": {
        "icon-size": 14,
        "spacing": 10
    }
}
