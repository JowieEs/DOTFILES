# ==============================================================================
#  Visuals & Theme
# ==============================================================================

# Colors
set $color_focus #e1251b
set $color_unfocus #333333

# Borders & Gaps
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
smart_gaps on
gaps inner 10
gaps outer 0

# Class colors
client.focused          $color_focus $color_focus #FFFFFF $color_focus
