# ==============================================================================
#  Autostart Applications & Daemons
# ==============================================================================

# --- System Services ---
# Fix for apps not seeing the Wayland session (screen sharing, etc.)
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK

# Audio effects (runs in background)
exec easyeffects --gapplication-service

# On-screen display server (volume/brightness popups)
exec swayosd-server

# Start the Polkit authentication agent
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# --- User Interface ---
# Network Manager Applet (system tray icon)
exec nm-applet --indicator

# Status Bar
exec waybar

# Notification Daemon
exec swaync

# Foot server
exec foot --server

# Idle configuration
set $lock ~/.config/sway/scripts/lock.sh
set $suspend ~/.config/sway/scripts/suspend.sh

exec swayidle -w \
    timeout 120 $lock \
    timeout 300 $suspend \
    before-sleep $lock
