# ==============================================================================
#  Autostart Applications & Daemons
# ==============================================================================

# --- System Services ---
# Fix for apps not seeing the Wayland session (screen sharing, etc.)
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK
exec export _JAVA_AWT_WM_NONREPARENTING=1

# Audio effects (runs in background)
exec easyeffects --gapplication-service

# Start the Polkit authentication agent
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# OSD server
exec swayosd-server

# Status Bar
exec waybar

# Notification Daemon
exec mako

# Foot server
#exec foot --server

# Kitty Daemon
exec kitty -1 --start-as=hidden

# Display Managment
exec_always pkill kanshi; exec kanshi

# Idle configuration
set $lock ~/.config/sway/scripts/lock.sh
set $suspend ~/.config/sway/scripts/suspend.sh

exec swayidle -w \
    timeout 120 $lock \
    timeout 300 $suspend \
    before-sleep $lock
