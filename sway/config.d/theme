# ==============================================================================
#  Visuals & Theme
# ==============================================================================

# --- One Dark Warm Palette ---
set $bg_0         #2c2d30
set $bg_1         #35373b
set $fg           #b1b4b9
set $orange       #c99a6e
set $blue         #68aee8
set $red          #e16d77
set $dark_grey    #3e4045

# --- Window Colors ---
# class                 border      background  text    indicator   child_border
client.focused          $red     $red     $bg_0   $red     $red
client.focused_inactive $dark_grey  $bg_1       $fg     $dark_grey  $dark_grey
client.unfocused        $dark_grey  $bg_0       $fg     $dark_grey  $dark_grey
client.urgent           $orange        $orange        $bg_0   $orange        $orange

# Borders & Gaps
default_border pixel 1
default_floating_border pixel 1

smart_borders on
smart_gaps on

# Space between individual windows
gaps inner 10
# Space between windows and the screen edges
gaps outer 0
