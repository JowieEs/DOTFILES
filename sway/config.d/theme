# ==============================================================================
#  Visuals & Theme
# ==============================================================================

# Colors
set $color_focus #e1251b
set $color_unfocus #333333

# Borders & Gaps
default_border pixel 2           # Keeps the 2px focus border around windows
default_floating_border pixel 2  # Keeps the 2px border for floating windows

smart_borders on
#smart_gaps on

#gaps inner 8
#gaps outer 4

gaps inner 0
gaps outer 0

# Class colors
client.focused          $color_focus $color_focus #FFFFFF $color_focus

