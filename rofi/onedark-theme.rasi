/**
 * Rofi Theme - One Dark Warm
 */

configuration {
    font: "BlexMono Nerd Font 11";
    show-icons: false;
    display-drun: "";
    drun-display-format: "{name}";
}

* {
    /* One Dark Warm Palette */
    bg:           #2c2d30; /* bg0 */
    bg-alt:       #35373b; /* bg1 */
    fg:           #b1b4b9; /* fg */
    fg-alt:       #646568; /* grey */
    
    accent:    #e16d77;  /* red */
    accent-text:  #191a1c; /* black */

    background-color: @bg;
    text-color:       @fg;
}

window {
    location:       center;
    anchor:         center;
    width:          350px;
    border:         1px;
    border-color:   @accent;
    padding:        10px;
}

inputbar {
    children:         [ prompt, entry ];
    background-color: @bg-alt;
    padding:          10px;
    margin:           0px 0px 10px 0px;
}

prompt {
    background-color: inherit;
    text-color:       @accent;
    padding:          0px 10px 0px 0px;
}

entry {
    background-color: inherit;
    placeholder:      "Search...";
    placeholder-color: @fg-alt;
}

listview {
    lines:      8;
    columns:    1;
    scrollbar:  false;
    spacing:    4px;
    border:     0px;
}

element {
    padding:        8px 10px;
}

element selected {
    background-color: @accent;
    text-color:       @accent-text;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
}
